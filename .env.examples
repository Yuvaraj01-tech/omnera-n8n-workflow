# ==============================================================================
# OMNERA AUTOMATION PIPELINE - CONFIGURATION TEMPLATE
# ==============================================================================

# n8n Orchestrator Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata

# Groq Cloud API
GROQ_API_KEY=gsk_your_groq_api_key_placeholder
GROQ_MODEL=llama3-70b-8192

# ImgBB Image Hosting
IMGBB_API_KEY=your_imgbb_api_key_placeholder

# Meta / Instagram Graph API
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_GRAPH_ACCESS_TOKEN=your_long_lived_system_user_token

# Push Notification Gateway
NTFY_TOPIC=omnera_approvals_unique_token
NTFY_AUTH_TOKEN=tk_optional_bearer_token

# Local Service Resolution (Use docker service name inside containers)
POSTER_SERVICE_URL=http://poster-service:5000/generate
